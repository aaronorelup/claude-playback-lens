# Runtime index/cache — rebuilt on first run, and derived from local transcripts
.cache/
lenscache*/

# Editor / harness local state
.claude/

# Research script OUTPUTS. The .mjs scripts that produced them are kept, but the
# dumps themselves contain verbatim prompt text from private local sessions.
docs/research/scripts/**/*.json

# Logs and scratch
*.log
node_modules/

# Error logs from research scripts — noise
docs/research/scripts/**/*.err

# generated by tests/fixtures/api/make-store.mjs on every suite run
tests/fixtures/api/store/

# maintainer-local research digest: distilled from the private corpus, never published
docs/research/_digest.md

# Maintainer-local planning docs (specs, briefs, hosting notes) — deliberately
# never published; before this entry they survived only by never being staged.
claude/

# Analytics outputs produced by driving the MCP server over the private corpus.
# They carry real per-project cost figures and must never land in this public
# repo. The trailing glob catches parallel-run variants.
project-analytics.md
usage-by-billing-period*.md

# Per-session agent accounting — real cost figures from the private corpus,
# kept on disk for the maintainer, never published. Moved here from the old
# MCP repo in the KAN-126 merge; its history stays in that archived repo.
ACCOUNTING.md
